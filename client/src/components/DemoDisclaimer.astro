---
const isDemo = import.meta.env.PUBLIC_DEPLOYMENT_TYPE === 'DEMO';
---

{isDemo && (
    <div id="demo-disclaimer" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 transition-opacity duration-300">
        <div class="bg-zinc-900 border border-zinc-700/50 rounded-2xl max-w-md w-full p-6 shadow-2xl relative text-center">
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
            </div>
            <h2 class="text-xl font-bold text-white mb-3">Notice</h2>
            <p class="text-zinc-300 text-sm leading-relaxed mb-6">
                This deployment is just to showcase the application as described on GitHub. The radios listed here are not real providers; they use free, non-copyrighted music simply to showcase the player functionality.
            </p>
            <button id="close-demo" class="w-full py-2.5 px-4 bg-white hover:bg-zinc-200 text-black font-semibold rounded-xl transition-colors cursor-pointer">
                I Understand
            </button>
        </div>
    </div>
    
    <script>
        const disclaimer = document.getElementById('demo-disclaimer');
        const closeBtn = document.getElementById('close-demo');
        
        if (disclaimer && closeBtn) {
            closeBtn.addEventListener('click', () => {
                disclaimer.style.opacity = '0';
                setTimeout(() => {
                    disclaimer.remove();
                }, 300);
            });
        }
    </script>
)}
