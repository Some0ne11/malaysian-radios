---
import { Play, Pause, SkipBack, SkipForward, Radio, Heart, ChevronUp, Sun, Moon, Loader2, AlertCircle } from '@lucide/astro';
import type { Station } from '../hooks/useStations';

export interface Props {
    stations: Station[];
}

const { stations = [] } = Astro.props;
const hasStations = stations.length > 0;
---
<div class="flex flex-col w-full lg:w-96 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-zinc-800 p-6 lg:p-8 bg-slate-100/90 dark:bg-zinc-900/90 h-full">
    <!-- Sidebar Header / Navbar -->
    <div class="flex items-center justify-between shrink-0">
        <h2 class="text-xs font-bold tracking-widest text-slate-500 dark:text-zinc-400 uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-none bg-error animate-pulse"></span>
            Now Playing
        </h2>
        
        <!-- Theme Toggle -->
        <label class="cursor-pointer flex items-center justify-center p-2 -mr-2 text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors">
            <input type="checkbox" id="theme-toggle" class="peer sr-only" />
            <Sun class="w-5 h-5 hidden peer-checked:block" />
            <Moon class="w-5 h-5 block peer-checked:hidden" />
        </label>
    </div>

    <!-- Centered Content Wrapper -->
    <div class="flex-1 flex flex-col justify-center">
        {hasStations ? (
            <>
                <!-- Empty State Container (Visible by default) -->
                <div id="empty-state-container" class="flex flex-col items-center justify-center text-center p-8 bg-slate-50 dark:bg-zinc-900 border border-slate-200/50 dark:border-zinc-800/50">
                    <Radio class="w-16 h-16 text-slate-300 dark:text-zinc-700 mb-4 animate-pulse" />
                    <h3 class="font-bold text-slate-900 dark:text-zinc-100 text-lg">No Station Selected</h3>
                    <p class="text-sm text-slate-500 dark:text-zinc-400 mt-2">Pick a station from the list to start listening</p>
                </div>

                <!-- Player Container (Hidden by default) -->
                <div id="player-container" class="hidden flex-col w-full">
                    <div class="mb-4 relative">
                        <!-- Logo Area -->
                        <div class="aspect-square w-full bg-slate-200 dark:bg-zinc-800 rounded-none flex items-center justify-center shadow-inner overflow-hidden relative group">
                            <img id="now-playing-logo" src="" alt="Radio Logo" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="eager" decoding="async" />
                            <!-- Error Overlay -->
                            <div id="player-error-overlay" class="absolute inset-0 bg-black/80 flex flex-col items-center justify-center text-white opacity-0 pointer-events-none transition-opacity duration-300 z-10">
                                <AlertCircle class="w-12 h-12 text-error mb-2 animate-pulse" />
                                <span class="text-sm font-bold tracking-wider uppercase text-error">Stream Error</span>
                            </div>
                        </div>
                    </div>

                    <!-- Station Info -->
                    <div class="mb-4 text-center relative flex justify-center items-center gap-2">
                        <div class="flex-1 min-w-0">
                            <h3 id="now-playing-title" class="font-bold text-2xl text-slate-900 dark:text-zinc-100 truncate">Title</h3>
                            <p id="now-playing-category" class="text-xs text-slate-500 dark:text-zinc-400 uppercase font-semibold tracking-widest mt-1">Category</p>
                        </div>
                        <button id="sidebar-favorite-btn" class="shrink-0 text-slate-400 hover:text-red-500 transition-colors hidden" aria-label="Toggle Favorite">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="heart-icon"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
                        </button>
                    </div>

                    <!-- Playback Controls -->
                    <div class="flex flex-col mt-2">
                        <div class="bg-slate-50 dark:bg-zinc-900 rounded-none p-6 shadow-sm border border-slate-200/50 dark:border-zinc-800/50">
                            <audio id="main-audio-player" class="w-0 h-0 absolute opacity-0 pointer-events-none" preload="none" controls playsinline>
                                <source src="">
                            </audio>
                            <div class="flex items-center justify-center mb-4">
                                <div class="flex items-center gap-6">
                                    <button id="btn-prev" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                        <SkipBack class="w-4 h-4" />
                                    </button>
                                    <button id="play-pause-btn" class="flex items-center justify-center w-14 h-14 rounded-none bg-primary text-white shadow-lg shadow-primary/30 transform transition-transform active:scale-95 hover:bg-primary/90 relative">
                                        <Play id="play-icon" class="w-6 h-6 ml-1 absolute" />
                                        <Pause id="pause-icon" class="w-6 h-6 hidden absolute" />
                                        <Loader2 id="loading-icon" class="w-6 h-6 hidden animate-spin absolute" />
                                    </button>
                                    <button id="btn-next" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                        <SkipForward class="w-4 h-4" />
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Audio Visualizer (Equalizer) -->
                            <div class="flex items-center gap-3">
                                <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400">LIVE</span>
                                
                                <!-- Audio Visualizer (Sine Wave) -->
                                <div id="audio-visualizer" class="flex-1 flex items-center justify-center h-6 opacity-30 transition-opacity duration-300 px-2 overflow-hidden relative">
                                    <svg class="w-full h-full text-primary" viewBox="0 0 200 40" preserveAspectRatio="none">
                                        <g class="wave-group">
                                            <!-- High amplitude wave -->
                                            <path class="wave wave-1" d="M 0 20 Q 25 0, 50 20 T 100 20 T 150 20 T 200 20 T 250 20 T 300 20 T 350 20 T 400 20" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
                                            <!-- Medium amplitude wave -->
                                            <path class="wave wave-2" d="M 0 20 Q 25 8, 50 20 T 100 20 T 150 20 T 200 20 T 250 20 T 300 20 T 350 20 T 400 20" fill="none" stroke="currentColor" stroke-width="2" opacity="0.6" vector-effect="non-scaling-stroke" />
                                            <!-- Low amplitude wave -->
                                            <path class="wave wave-3" d="M 0 20 Q 25 15, 50 20 T 100 20 T 150 20 T 200 20 T 250 20 T 300 20 T 350 20 T 400 20" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3" vector-effect="non-scaling-stroke" />
                                        </g>
                                    </svg>
                                </div>

                                <!-- Live Indicator -->
                                <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400 relative flex h-2 w-2">
                                    <span id="live-indicator-ping" class="absolute inline-flex h-full w-full rounded-none bg-error opacity-75 hidden"></span>
                                    <span id="live-indicator-dot" class="relative inline-flex rounded-none h-2 w-2 bg-slate-300 dark:bg-zinc-700 transition-colors"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </>
        ) : (
            <div class="text-center p-6 bg-slate-50 dark:bg-zinc-900 border border-slate-200/50 dark:border-zinc-800/50">
                <Radio class="w-12 h-12 mx-auto text-slate-300 dark:text-zinc-700 mb-4" />
                <h3 class="font-bold text-slate-900 dark:text-zinc-100">No Stations Found</h3>
                <p class="text-sm text-slate-500 dark:text-zinc-400 mt-2">Could not connect to the server or database is empty.</p>
            </div>
        )}
    </div>

    <!-- Social Links & Mobile Drawer Toggle -->
    <div class="flex flex-col items-center gap-4 lg:gap-6 mt-auto">
        <div class="flex justify-center gap-4">
            <a href="https://github.com/Some0ne11/malaysian-radios" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
        </div>
        
        <!-- Mobile Open Grid Button -->
        <button id="open-grid-btn" class="lg:hidden flex flex-col items-center justify-center text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors animate-bounce">
            <span class="text-[10px] font-bold tracking-widest uppercase mb-1">Stations</span>
            <ChevronUp class="w-6 h-6" />
        </button>
    </div>
</div>

<script src="../scripts/sidebar.ts"></script>

<style>
    @keyframes scroll-wave {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100px); }
    }
    .playing .wave {
        animation: scroll-wave linear infinite;
    }
    .playing .wave-1 { animation-duration: 1.2s; }
    .playing .wave-2 { animation-duration: 1.8s; }
    .playing .wave-3 { animation-duration: 2.4s; }
</style>