---
import { Play, Pause, SkipBack, SkipForward, Radio, Heart, ChevronUp, Sun, Moon } from '@lucide/astro';
---
<div class="flex flex-col w-full lg:w-96 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-zinc-800 p-6 lg:p-8 bg-slate-100/90 dark:bg-zinc-900/90 h-full">
    <div class="mb-6 relative">
        <div class="absolute top-0 right-0 -mt-2 -mr-2">
            <!-- Theme Toggle -->
            <label class="cursor-pointer flex items-center justify-center p-2 text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors">
                <input type="checkbox" id="theme-toggle" class="peer sr-only" />
                <!-- sun icon (shown when checked, meaning light mode) -->
                <Sun class="w-5 h-5 hidden peer-checked:block" />
                <!-- moon icon (shown when unchecked, meaning dark mode) -->
                <Moon class="w-5 h-5 block peer-checked:hidden" />
            </label>
        </div>
        
        <h2 class="text-xs font-bold tracking-widest text-slate-500 dark:text-zinc-400 uppercase mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-none bg-error animate-pulse"></span>
            Now Playing
        </h2>
        
        <!-- Logo Area -->
        <div class="aspect-square w-full bg-slate-200 dark:bg-zinc-800 rounded-none flex items-center justify-center shadow-inner overflow-hidden relative group">
            <!-- Placeholder logo, in real app this would be an img -->
            <img id="now-playing-logo" src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/Suria_logo-01.png/1280px-Suria_logo-01.png" alt="Radio Logo" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 dark:from-zinc-900/80 to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4">
                <h3 id="now-playing-title" class="font-bold text-xl text-white truncate drop-shadow-md">SURIA FM</h3>
                <p id="now-playing-category" class="text-xs text-white/80 uppercase font-semibold">RADIO</p>
            </div>
        </div>
    </div>

    <!-- Playback Controls -->
    <div class="flex-1 flex flex-col justify-center">
        <div class="bg-slate-50 dark:bg-zinc-900 rounded-none p-6 shadow-sm border border-slate-200/50 dark:border-zinc-800/50">
            <audio id="main-audio-player" class="hidden" preload="none" controls>
                <source src="https://playerservices.streamtheworld.com/api/livestream-redirect/SURIA_FMAAC" type="audio/aac">
            </audio>
            
            <div class="flex items-center justify-between mb-4">
                <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                    <Heart class="w-4 h-4" />
                </button>
                <div class="flex items-center gap-4">
                    <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                        <SkipBack class="w-4 h-4" />
                    </button>
                    <button id="play-pause-btn" class="flex items-center justify-center w-14 h-14 rounded-none bg-primary text-white shadow-lg shadow-primary/30 transform transition-transform active:scale-95 hover:bg-primary/90">
                        <Play id="play-icon" class="w-6 h-6 ml-1" />
                        <Pause id="pause-icon" class="w-6 h-6 hidden" />
                    </button>
                    <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                        <SkipForward class="w-4 h-4" />
                    </button>
                </div>
                <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                    <Radio class="w-4 h-4" />
                </button>
            </div>
            
            <!-- Progress bar (fake for radio, just visualization) -->
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400">LIVE</span>
                <div class="w-full h-1.5 bg-slate-200 dark:bg-zinc-800 relative overflow-hidden rounded-none">
                    <div class="absolute top-0 left-0 h-full w-full bg-primary"></div>
                </div>
                <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400 relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-none bg-error opacity-75"></span>
                  <span class="relative inline-flex rounded-none h-2 w-2 bg-error"></span>
                </span>
            </div>
        </div>
    </div>

    <!-- Social Links & Mobile Drawer Toggle -->
    <div class="mt-6 lg:mt-8 flex flex-col items-center gap-4 lg:gap-6 mt-auto lg:mt-8">
        <div class="flex justify-center gap-4">
            <!-- SVG icons for social to not overload lucide -->
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
        </div>
        
        <!-- Mobile Open Grid Button -->
        <button id="open-grid-btn" class="lg:hidden flex flex-col items-center justify-center text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors animate-bounce">
            <span class="text-[10px] font-bold tracking-widest uppercase mb-1">Stations</span>
            <ChevronUp class="w-6 h-6" />
        </button>
    </div>
</div>

<script>
    // Simple client side script to handle play/pause for the HTML5 audio
    const btn = document.getElementById('play-pause-btn');
    const audio = document.getElementById('main-audio-player') as HTMLAudioElement;

    if(btn && audio) {
        btn.addEventListener('click', () => {
            const playIcon = document.getElementById('play-icon');
            const pauseIcon = document.getElementById('pause-icon');
            
            if(audio.paused) {
                audio.play();
                if(playIcon) playIcon.classList.add('hidden');
                if(pauseIcon) pauseIcon.classList.remove('hidden');
            } else {
                audio.pause();
                if(playIcon) playIcon.classList.remove('hidden');
                if(pauseIcon) pauseIcon.classList.add('hidden');
            }
        });
    }
</script>