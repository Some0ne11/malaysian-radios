---
import { Play, Pause, SkipBack, SkipForward, Radio, Heart, ChevronUp, Sun, Moon, Loader2, AlertCircle } from '@lucide/astro';
import { fetchStations } from '../hooks/useStations';

const response = await fetchStations(20, 0);
const stations = response ? response.stations : [];
const hasStations = stations.length > 0;
const defaultStation = hasStations ? stations[0] : null;
---
<div class="flex flex-col w-full lg:w-96 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-zinc-800 p-6 lg:p-8 bg-slate-100/90 dark:bg-zinc-900/90 h-full">
    <!-- Sidebar Header / Navbar -->
    <div class="flex items-center justify-between shrink-0">
        <h2 class="text-xs font-bold tracking-widest text-slate-500 dark:text-zinc-400 uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-none bg-error animate-pulse"></span>
            Now Playing
        </h2>
        
        <!-- Theme Toggle -->
        <label class="cursor-pointer flex items-center justify-center p-2 -mr-2 text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors">
            <input type="checkbox" id="theme-toggle" class="peer sr-only" />
            <Sun class="w-5 h-5 hidden peer-checked:block" />
            <Moon class="w-5 h-5 block peer-checked:hidden" />
        </label>
    </div>

    <!-- Centered Content Wrapper -->
    <div class="flex-1 flex flex-col justify-center">
        {hasStations && defaultStation ? (
            <>
                <div class="mb-4 relative">
                <!-- Logo Area -->
                <div class="aspect-square w-full bg-slate-200 dark:bg-zinc-800 rounded-none flex items-center justify-center shadow-inner overflow-hidden relative group">
                    <img id="now-playing-logo" src={defaultStation.logo_url} alt="Radio Logo" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    <!-- Error Overlay -->
                    <div id="player-error-overlay" class="absolute inset-0 bg-black/80 flex flex-col items-center justify-center text-white opacity-0 pointer-events-none transition-opacity duration-300 z-10">
                        <AlertCircle class="w-12 h-12 text-error mb-2 animate-pulse" />
                        <span class="text-sm font-bold tracking-wider uppercase text-error">Stream Error</span>
                    </div>
                </div>
                </div>

                <!-- Station Info -->
                <div class="mb-4 text-center">
                    <h3 id="now-playing-title" class="font-bold text-2xl text-slate-900 dark:text-zinc-100 truncate">{defaultStation.name}</h3>
                    <p id="now-playing-category" class="text-xs text-slate-500 dark:text-zinc-400 uppercase font-semibold tracking-widest mt-1">{defaultStation.category_id}</p>
                </div>

                <!-- Playback Controls -->
                <div class="flex flex-col mt-2">
                    <div class="bg-slate-50 dark:bg-zinc-900 rounded-none p-6 shadow-sm border border-slate-200/50 dark:border-zinc-800/50">
                        <audio id="main-audio-player" class="hidden" preload="none" controls>
                            <source src={defaultStation.stream_url}>
                        </audio>
                        
                        <div class="flex items-center justify-between mb-4">
                            <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                <Heart class="w-4 h-4" />
                            </button>
                            <div class="flex items-center gap-4">
                                <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                    <SkipBack class="w-4 h-4" />
                                </button>
                                <button id="play-pause-btn" class="flex items-center justify-center w-14 h-14 rounded-none bg-primary text-white shadow-lg shadow-primary/30 transform transition-transform active:scale-95 hover:bg-primary/90 relative">
                                    <Play id="play-icon" class="w-6 h-6 ml-1 absolute" />
                                    <Pause id="pause-icon" class="w-6 h-6 hidden absolute" />
                                    <Loader2 id="loading-icon" class="w-6 h-6 hidden animate-spin absolute" />
                                </button>
                                <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                    <SkipForward class="w-4 h-4" />
                                </button>
                            </div>
                            <button class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                                <Radio class="w-4 h-4" />
                            </button>
                        </div>
                        
                        <!-- Progress bar (fake for radio, just visualization) -->
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400">LIVE</span>
                            <div class="w-full h-1.5 bg-slate-200 dark:bg-zinc-800 relative overflow-hidden rounded-none">
                                <div class="absolute top-0 left-0 h-full w-full bg-primary"></div>
                            </div>
                            <span class="text-[10px] font-mono text-slate-500 dark:text-zinc-400 relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-none bg-error opacity-75"></span>
                            <span class="relative inline-flex rounded-none h-2 w-2 bg-error"></span>
                            </span>
                        </div>
                    </div>
                </div>
            </>
        ) : (
            <div class="text-center p-6 bg-slate-50 dark:bg-zinc-900 border border-slate-200/50 dark:border-zinc-800/50">
                <Radio class="w-12 h-12 mx-auto text-slate-300 dark:text-zinc-700 mb-4" />
                <h3 class="font-bold text-slate-900 dark:text-zinc-100">No Stations Found</h3>
                <p class="text-sm text-slate-500 dark:text-zinc-400 mt-2">Could not connect to the server or database is empty.</p>
            </div>
        )}
    </div>

    <!-- Social Links & Mobile Drawer Toggle -->
    <div class="flex flex-col items-center gap-4 lg:gap-6 mt-auto">
        <div class="flex justify-center gap-4">
            <!-- SVG icons for social to not overload lucide -->
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            <a href="#" class="flex items-center justify-center w-8 h-8 rounded-none text-slate-500 hover:bg-slate-200 hover:text-slate-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
        </div>
        
        <!-- Mobile Open Grid Button -->
        <button id="open-grid-btn" class="lg:hidden flex flex-col items-center justify-center text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors animate-bounce">
            <span class="text-[10px] font-bold tracking-widest uppercase mb-1">Stations</span>
            <ChevronUp class="w-6 h-6" />
        </button>
    </div>
</div>

<script>
    import { fetchStationById } from '../hooks/useStations';

    const btn = document.getElementById('play-pause-btn');
    const audio = document.getElementById('main-audio-player') as HTMLAudioElement;
    
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const loadIcon = document.getElementById('loading-icon');
    const errorOverlay = document.getElementById('player-error-overlay');

    if(btn && audio) {
        // Toggle play/pause on click
        btn.addEventListener('click', () => {
            if(audio.paused) {
                audio.play().catch(() => {}); // Catch error to prevent unhandled rejection in console
            } else {
                audio.pause();
            }
        });

        // Audio state event listeners for robust UI updates
        audio.addEventListener('loadstart', () => {
            if (playIcon) playIcon.classList.add('hidden');
            if (pauseIcon) pauseIcon.classList.add('hidden');
            if (loadIcon) loadIcon.classList.remove('hidden');
            if (errorOverlay) errorOverlay.classList.remove('opacity-100');
        });

        audio.addEventListener('waiting', () => {
            if (playIcon) playIcon.classList.add('hidden');
            if (pauseIcon) pauseIcon.classList.add('hidden');
            if (loadIcon) loadIcon.classList.remove('hidden');
        });

        audio.addEventListener('playing', () => {
            if (playIcon) playIcon.classList.add('hidden');
            if (loadIcon) loadIcon.classList.add('hidden');
            if (pauseIcon) pauseIcon.classList.remove('hidden');
            if (errorOverlay) errorOverlay.classList.remove('opacity-100');
        });

        audio.addEventListener('pause', () => {
            if (pauseIcon) pauseIcon.classList.add('hidden');
            if (loadIcon) loadIcon.classList.add('hidden');
            if (playIcon) playIcon.classList.remove('hidden');
        });

        audio.addEventListener('error', () => {
            // Revert icon to play
            if (pauseIcon) pauseIcon.classList.add('hidden');
            if (loadIcon) loadIcon.classList.add('hidden');
            if (playIcon) playIcon.classList.remove('hidden');
            // Show error overlay
            if (errorOverlay) errorOverlay.classList.add('opacity-100');
        });
    }

    // Listen for cross-component play-station events
    window.addEventListener('play-station', async (e: any) => {
        const { id, name, category, logo } = e.detail;
        
        const titleEl = document.getElementById('now-playing-title');
        const categoryEl = document.getElementById('now-playing-category');
        const logoEl = document.getElementById('now-playing-logo') as HTMLImageElement;
        const sourceEl = audio?.querySelector('source');

        if (titleEl) titleEl.textContent = name;
        if (categoryEl) categoryEl.textContent = category;
        if (logoEl) logoEl.src = logo;
        
        // Show loading state while fetching stream url securely
        if (playIcon) playIcon.classList.add('hidden');
        if (pauseIcon) pauseIcon.classList.add('hidden');
        if (loadIcon) loadIcon.classList.remove('hidden');
        
        try {
            const gridEl = document.getElementById('radio-grid');
            const token = gridEl?.dataset.token || '';
            
            const stationInfo = await fetchStationById(id, token);
            
            if (stationInfo && audio && sourceEl) {
                sourceEl.src = stationInfo.stream_url;
                audio.load(); // Required to load the new source
                audio.play().catch(() => {});
            } else {
                throw new Error("Failed to secure fetch station stream");
            }
        } catch (err) {
            console.error(err);
            if (loadIcon) loadIcon.classList.add('hidden');
            if (playIcon) playIcon.classList.remove('hidden');
            if (errorOverlay) errorOverlay.classList.add('opacity-100');
        }
    });
</script>