---
import Sidebar from './Sidebar.astro';
import RadioGrid from './RadioGrid.astro';
---

<!-- The big container card that holds the whole UI -->
<div class="w-full max-w-[1400px] h-[90vh] max-h-[900px] bg-white/80 dark:bg-zinc-900/80 backdrop-blur-2xl shadow-2xl rounded-none border border-slate-200/50 dark:border-zinc-800/50 flex flex-col lg:flex-row overflow-hidden relative z-0 ring-1 ring-slate-900/5 dark:ring-white/5">
    <Sidebar />
    <RadioGrid />
</div>