---
import Sidebar from './Sidebar.astro';
import RadioGrid from './RadioGrid.astro';
---

<!-- The big container card that holds the whole UI -->
<div class="w-full max-w-[1400px] h-[90vh] max-h-[900px] backdrop-blur-2xl shadow-2xl rounded-none border border-slate-200/50 dark:border-zinc-800/50 flex flex-col lg:flex-row overflow-hidden relative z-0 ring-1 ring-slate-900/5 dark:ring-white/5 bg-transparent">
    <Sidebar />
    <RadioGrid />
</div>

<script>
    // Handle mobile drawer open/close
    const openBtn = document.getElementById('open-grid-btn');
    const closeBtn = document.getElementById('close-grid-btn');
    const grid = document.getElementById('radio-grid');

    if(openBtn && closeBtn && grid) {
        openBtn.addEventListener('click', () => {
            grid.classList.remove('translate-y-full');
            grid.classList.add('translate-y-0');
        });
        closeBtn.addEventListener('click', () => {
            grid.classList.add('translate-y-full');
            grid.classList.remove('translate-y-0');
        });
    }
</script>