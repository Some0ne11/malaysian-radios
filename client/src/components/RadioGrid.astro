---
import RadioCard from './RadioCard.astro';
import { ChevronDown } from '@lucide/astro';

// Dummy data for now, eventually fetched from Turso via Golang backend
const stations = [
    { id: '1', name: 'ERA FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/0/07/Era_FM_Logo_2018.png/220px-Era_FM_Logo_2018.png' },
    { id: '2', name: 'SINAR FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/6/6d/Sinar_FM_Logo_2018.png/220px-Sinar_FM_Logo_2018.png' },
    { id: '3', name: 'MY FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/4/4c/MY_FM_Logo_2018.png/220px-MY_FM_Logo_2018.png' },
    { id: '4', name: 'HITZ FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/7/7f/Hitz_FM_Logo_2018.png/220px-Hitz_FM_Logo_2018.png' },
    { id: '5', name: 'MIX FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/e/e0/Mix_FM_Logo_2018.png/220px-Mix_FM_Logo_2018.png' },
    { id: '6', name: 'LITE FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/8/87/Lite_FM_Logo_2018.png/220px-Lite_FM_Logo_2018.png' },
    { id: '7', name: 'MELODY FM', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/8/86/Melody_FM_Logo_2018.png/220px-Melody_FM_Logo_2018.png' },
    { id: '8', name: 'GEGAR', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/0/0d/Gegar_Logo_2018.png/220px-Gegar_Logo_2018.png' },
    { id: '9', name: 'ZAYAN', category: 'RADIO', logo_url: 'https://upload.wikimedia.org/wikipedia/en/thumb/8/82/Zayan_Logo_2018.png/220px-Zayan_Logo_2018.png' },
];
---

<div id="radio-grid" class="absolute inset-0 lg:static flex-1 flex flex-col bg-white/95 dark:bg-zinc-950/95 backdrop-blur-3xl z-20 max-lg:translate-y-full transition-transform duration-500 ease-in-out w-full lg:w-auto">
    
    <!-- Fixed Header Section -->
    <div class="p-6 lg:p-8 pb-4 lg:pb-6 border-b border-slate-200/50 dark:border-zinc-800/50 shrink-0 bg-slate-100/90 dark:bg-zinc-900/90">
    
      <!-- Mobile Close Grid Button -->
      <div class="flex justify-center mb-6 lg:hidden">
          <button id="close-grid-btn" class="flex flex-col items-center justify-center text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors">
              <ChevronDown class="w-8 h-8" />
              <span class="text-[10px] font-bold tracking-widest uppercase mt-1">Player</span>
          </button>
      </div>
    
      <div class="flex justify-between items-end">
          <div>
              <h1 class="text-3xl font-black text-slate-900 dark:text-zinc-100 tracking-tight">Discover</h1>
              <p class="text-slate-500 dark:text-zinc-400 mt-1">Listen to your favorite Malaysian radio stations</p>
          </div>
      </div>
    </div>

    <!-- Scrollable Grid Section -->
    <div class="flex-1 overflow-y-auto hide-scrollbar p-6 lg:p-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 pb-20 lg:pb-0">
        {stations.map(station => (
            <RadioCard 
                id={station.id}
                name={station.name}
                category={station.category}
                logo_url={station.logo_url}
            />
        ))}
        </div>
    </div>
</div>