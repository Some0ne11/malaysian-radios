---
import RadioCard from './RadioCard.astro';
import { ChevronDown } from '@lucide/astro';
import type { Station } from '../hooks/useStations';

export interface Props {
    stations: Station[];
    initialToken: string;
    isBanned?: boolean;
}

const { stations = [], initialToken = '', isBanned = false } = Astro.props;
---

<div id="radio-grid" data-token={initialToken} class="absolute inset-0 lg:static flex-1 flex flex-col bg-white/95 dark:bg-zinc-950/95 backdrop-blur-3xl z-20 max-lg:translate-y-full transition-transform duration-500 ease-in-out w-full lg:w-auto">
    
    <!-- Fixed Header Section -->
    <div class="p-6 lg:p-8 pb-4 lg:pb-6 border-b border-slate-200/50 dark:border-zinc-800/50 shrink-0 bg-slate-100/90 dark:bg-zinc-900/90">
    
      <!-- Mobile Close Grid Button -->
      <div class="flex justify-center mb-6 lg:hidden">
          <button id="close-grid-btn" class="flex flex-col items-center justify-center text-slate-500 hover:text-primary dark:text-zinc-400 dark:hover:text-primary transition-colors">
              <ChevronDown class="w-8 h-8" />
              <span class="text-[10px] font-bold tracking-widest uppercase mt-1">Player</span>
          </button>
      </div>
    
      <div class="flex justify-between items-end gap-4">
          <div>
              <h1 class="text-3xl font-black text-slate-900 dark:text-zinc-100 tracking-tight">Discover</h1>
              <p class="text-slate-500 dark:text-zinc-400 mt-1">Listen to your favorite Malaysian radio stations</p>
          </div>
          <div class="shrink-0 mb-1 hidden sm:flex items-center gap-2">
              <button id="favorites-toggle-desktop" class="flex items-center justify-center gap-2 bg-white dark:bg-zinc-900 hover:bg-slate-50 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 px-4 py-2 rounded-lg font-medium outline-none focus:ring-2 focus:ring-primary/50 transition-all border border-slate-300 dark:border-zinc-700 text-sm shadow-sm group">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
                  Favorites
              </button>
              <select id="category-filter" class="bg-slate-200 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 px-4 py-2 rounded-lg font-medium outline-none focus:ring-2 focus:ring-primary/50 transition-all border border-slate-300 dark:border-zinc-700 cursor-pointer text-sm shadow-sm">
                  <option value="all">All Categories</option>
                  <option value="malay">Malay</option>
                  <option value="chinese">Chinese</option>
                  <option value="indian">Indian</option>
                  <option value="english">English</option>
              </select>
          </div>
      </div>
      <!-- Mobile Category Filter -->
      <div class="mt-4 flex sm:hidden gap-2">
          <button id="favorites-toggle-mobile" class="flex-shrink-0 flex items-center justify-center gap-2 bg-white dark:bg-zinc-900 hover:bg-slate-50 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 px-4 py-2.5 rounded-lg font-medium outline-none focus:ring-2 focus:ring-primary/50 transition-all border border-slate-300 dark:border-zinc-700 text-sm shadow-sm group">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
          </button>
          <select id="category-filter-mobile" class="w-full bg-slate-200 dark:bg-zinc-800 text-slate-700 dark:text-zinc-300 px-4 py-2.5 rounded-lg font-medium outline-none focus:ring-2 focus:ring-primary/50 transition-all border border-slate-300 dark:border-zinc-700 cursor-pointer text-sm shadow-sm">
              <option value="all">All Categories</option>
              <option value="malay">Malay</option>
              <option value="chinese">Chinese</option>
              <option value="indian">Indian</option>
              <option value="english">English</option>
          </select>
      </div>
    </div>

    <!-- Scrollable Grid Section -->
    <div class="flex-1 overflow-y-auto hide-scrollbar p-6 lg:p-8 relative">
        {isBanned ? (
            <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-white/50 dark:bg-zinc-950/50 backdrop-blur-sm z-10">
                <div class="w-20 h-20 mb-6 rounded-full bg-error/10 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Access Restricted</h2>
                <p class="text-slate-500 dark:text-zinc-400 max-w-md">
                    We've detected unusual activity from your session. You have been temporarily blocked for spamming requests.
                </p>
                <p class="text-error font-medium mt-4">
                    Please wait up to 1 hour before trying again.
                </p>
            </div>
        ) : (
            <>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 pb-20 lg:pb-0">
                {stations.length > 0 ? stations.map(station => (
                    <RadioCard 
                        id={station.id}
                        name={station.name}
                        category={station.category_id || 'UNKNOWN'}
                        logo_url={station.logo_url || ''}
                        stream_url={station.stream_url}
                    />
                )) : (
                    <div class="col-span-full flex flex-col items-center justify-center py-20 text-slate-500 dark:text-zinc-500">
                        <p>No radio stations available at the moment.</p>
                    </div>
                )}
                </div>
                
                {stations.length === 15 && (
                    <div id="load-more-trigger" class="w-full h-20 flex items-center justify-center mt-4 text-slate-400">
                        <span class="animate-pulse">Loading more...</span>
                    </div>
                )}
            </>
        )}
    </div>
</div>

<script src="../scripts/radioGrid.ts"></script>