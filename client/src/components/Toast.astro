---
import { Volume2 } from '@lucide/astro';
---

<div id="radio-toast" class="fixed bottom-6 right-6 z-50 bg-white text-slate-900 dark:bg-zinc-900 dark:text-zinc-100 px-6 py-4 shadow-2xl border-l-4 border-primary flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <Volume2 class="w-5 h-5 text-primary" />
    <span id="radio-toast-message" class="font-bold tracking-wide"></span>
</div>
